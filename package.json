{
  "name": "b2c-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "validate-visa": "node --experimental-strip-types scripts/validate-visa-data.ts",
    "validate:translations": "node --experimental-strip-types scripts/validate-translations.ts",
    "validate:checklist-i18n": "node --experimental-strip-types scripts/validate-checklist-i18n.ts",
    "build": "npm run validate-visa && npm run validate:translations && npm run validate:checklist-i18n && next build",
    "start": "next start",
    "lint": "eslint",
    "fix:translations": "node --experimental-strip-types scripts/fix-array-collapse.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@next/third-parties": "^16.1.6",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "google-play-scraper": "^10.1.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.574.0",
    "mapbox-gl": "^3.19.1",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "next-mdx-remote": "^6.0.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@googleapis/searchconsole": "^6.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "lefthook": "^2.1.4",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
