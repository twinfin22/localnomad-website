{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "instagram-stage1.schema.json",
  "title": "Instagram Stage 1 Output",
  "description": "DEPRECATED — see instagram-output.schema.json. Slide structure and content extracted from blog post, passed to Stage 2 (image generation) and Stage 3 (caption).",
  "type": "object",
  "required": [
    "sourceBlog",
    "carouselType",
    "templateId",
    "introSlide",
    "slides",
    "endingSlide",
    "totalSlides"
  ],
  "properties": {
    "sourceBlog": {
      "type": "object",
      "required": ["slug", "title", "category", "country"],
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["guides", "updates", "tips", "comparisons", "news", "stories"]
        },
        "country": {
          "type": "string",
          "enum": ["korea", "japan", "china", "taiwan", "sea", "global"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "carouselType": {
      "type": "string",
      "enum": ["CHECKLIST", "MYTH_BUSTER", "VS_COMPARE", "PHOTO_STORY", "QUIZ"],
      "description": "Carousel archetype (see style-guide for details)"
    },
    "templateId": {
      "type": "string",
      "description": "Contentdrips template ID to use for rendering."
    },
    "introSlide": {
      "type": "object",
      "required": ["heading"],
      "properties": {
        "heading": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 100 },
        "image": { "type": "string", "format": "uri" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 4,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["heading"],
        "properties": {
          "heading": { "type": "string", "maxLength": 80 },
          "description": { "type": "string", "maxLength": 100 },
          "image": { "type": "string", "format": "uri" }
        }
      }
    },
    "endingSlide": {
      "type": "object",
      "required": ["heading"],
      "properties": {
        "heading": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 100 },
        "image": { "type": "string", "format": "uri" }
      }
    },
    "totalSlides": {
      "type": "integer",
      "minimum": 6,
      "maximum": 11,
      "description": "Total count: intro + content slides + ending."
    },
    "legalFlags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Required disclaimers (e.g., 'taiwan-dual-language', 'tax-disclaimer')."
    }
  }
}