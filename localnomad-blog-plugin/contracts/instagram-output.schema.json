{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "instagram-output.schema.json",
  "title": "Instagram Pipeline Output",
  "description": "Unified output schema for the Instagram carousel pipeline. Combines slide structure (Stage 1) and caption/hashtag output (Stage 3).",
  "type": "object",
  "required": [
    "sourceBlog",
    "carouselType",
    "introSlide",
    "slides",
    "endingSlide",
    "caption",
    "hashtags",
    "images",
    "suggestedPostTime",
    "totalSlides"
  ],
  "properties": {
    "sourceBlog": {
      "type": "object",
      "required": ["slug", "title", "category", "country"],
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["guides", "updates", "tips", "comparisons", "news", "stories"]
        },
        "country": {
          "type": "string",
          "enum": ["korea", "japan", "china", "taiwan", "sea", "global"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "carouselType": {
      "type": "string",
      "enum": ["A", "B", "C"],
      "description": "A = list, B = comparison, C = narrative"
    },
    "introSlide": {
      "type": "object",
      "required": ["heading"],
      "properties": {
        "heading": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 100 }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 4,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["heading"],
        "properties": {
          "heading": { "type": "string", "maxLength": 80 },
          "description": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "endingSlide": {
      "type": "object",
      "required": ["heading"],
      "properties": {
        "heading": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 100 }
      }
    },
    "caption": {
      "type": "string",
      "maxLength": 2200,
      "description": "Full caption text (Instagram limit: 2,200 chars)."
    },
    "hashtags": {
      "type": "array",
      "minItems": 20,
      "maxItems": 30,
      "items": { "type": "string", "pattern": "^#" },
      "description": "20-30 hashtags, tiered by volume."
    },
    "legalFlags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Required disclaimers (e.g., 'taiwan-dual-language', 'tax-disclaimer')."
    },
    "images": {
      "type": "object",
      "required": ["backend", "templateId", "paths", "imageStatus"],
      "properties": {
        "backend": {
          "type": "string",
          "description": "Image generation backend used (e.g., 'contentdrips', 'canva')."
        },
        "templateId": {
          "type": "string",
          "description": "Template ID used for rendering slides."
        },
        "paths": {
          "type": "array",
          "minItems": 6,
          "maxItems": 11,
          "items": { "type": "string" },
          "description": "File paths to slide PNGs under public/images/instagram/[slug]/, in order."
        },
        "imageStatus": {
          "type": "string",
          "enum": ["complete", "pending", "failed"],
          "description": "Status of image generation for this carousel."
        }
      }
    },
    "suggestedPostTime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp (KST) for optimal posting."
    },
    "totalSlides": {
      "type": "integer",
      "minimum": 6,
      "maximum": 11,
      "description": "Total count: intro + content slides + ending."
    }
  }
}
