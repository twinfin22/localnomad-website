# Mapbox (for interactive neighborhood map)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.xxx

# Resend (for sending emails)
RESEND_API_KEY=re_xxx

# Airtable (for storing subscribers)
# Required fields in table: email, first name, source, page, created at, status
AIRTABLE_API_KEY=patXXX
AIRTABLE_BASE_ID=appXXX
AIRTABLE_TABLE_NAME=Leads

# Email settings
EMAIL_FROM=LocalNomad <welcome@mail.localnomad.club>
EMAIL_REPLY_TO=hey@localnomad.club
NOTION_RESOURCE_URL=https://localnomad.notion.site/local-resource-archive
