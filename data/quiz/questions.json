        "required": true,
        "options": [
          { "value": "yes-adequate", "label": "Yes, with adequate coverage", "description": "Includes repatriation coverage" },
          { "value": "yes-unsure", "label": "Yes, but unsure about coverage", "description": "May need to verify limits" },
          { "value": "no", "label": "No, need to get insurance", "description": "Will need to purchase before applying" }
        ]
      }
    ],
