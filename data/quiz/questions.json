  "conditionalQuestions": {
    "remote-work": [
      {
        "id": "annual-income",
        "title": "What is your annual income?",
        "subtitle": "F-1-D requires approximately $66,000+/year (₩88M, GNI × 2)",
        "type": "single",
        "required": true,
        "options": [
          { "value": "under-50k", "label": "Under $50,000", "description": "Below threshold" },
          { "value": "50k-66k", "label": "$50,000 - $65,999", "description": "Below threshold" },
          { "value": "66k-100k", "label": "$66,000 - $100,000", "description": "Meets F-1-D requirement" },
          { "value": "over-100k", "label": "Over $100,000", "description": "Comfortably above threshold" }
        ]
      },
      {
        "id": "health-insurance",
        "title": "Do you have international health insurance?",
        "subtitle": "F-1-D requires coverage including repatriation (₩100M+)",
